# --- Environment / secrets ---
.env
.env.local
.env.*.local
*.pem

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
build/
dist/
*.egg-info/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.ipynb_checkpoints/

# --- Node / Next.js ---
node_modules/
.next/
out/
.vercel/
.turbo/
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Data artifacts (never commit raw data) ---
data/
*.parquet
*.csv
*.feather
!pipeline/tests/fixtures/*.csv
!pipeline/tests/fixtures/*.parquet
# Curated reference data — small hand-maintained datasets that must be in
# repo for reproducibility (Pro Bowl rosters from Wikipedia, etc.)
!pipeline/data/
!pipeline/data/*.csv

# Pipeline parquet cache + manifest + one-off backfill logs.
# Per ADR-0009, raw nflverse pulls live on disk here (not in git).
pipeline/.cache/

# --- Databases ---
*.sqlite
*.sqlite3
*.db
pgdata/

# --- Editors / OS ---
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp

# --- Misc ---
*.log
tmp/
