{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "ES2022"]
  },
  "include": [
    "scripts/**/*.ts",
    "config.ts",
    "remotion-entry.tsx",
    "remotion/**/*.tsx",
    "remotion/**/*.ts"
  ]
}
