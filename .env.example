# Copy to .env and fill in.
# The web app reads web/.env.local; the pipeline reads this file or the process env.

# --- Postgres ---
# Local docker-compose default. Override with Supabase/Neon URL in production.
DATABASE_URL=postgres://nflgrades:nflgrades@localhost:5432/nflgrades

# --- Pipeline ---
# Comma-separated list of seasons to ingest. Default covers the NGS era.
SEASONS=2016,2017,2018,2019,2020,2021,2022,2023,2024,2025

# Directory for cached raw downloads from nfl_data_py (gitignored).
PIPELINE_CACHE_DIR=./pipeline/.cache

# Log level for pipeline scripts: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Web (also duplicated in web/.env.local.example) ---
NEXT_PUBLIC_APP_NAME=NFL Player Grades
